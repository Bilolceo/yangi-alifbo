<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_YangiAlifbo" targetNamespace="https://github.com/Bilolceo/yangi-alifbo" exporter="yangi-alifbo" exporterVersion="0.1">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_Tashkilot" name="Davlat tashkiloti: hujjatni yangi alifboga oʻtkazish" processRef="Process_Otkazish"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Otkazish" name="Hujjatni yangi alifboga oʻtkazish" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Xodim" name="Ish yurituvchi (xodim)">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Click</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tizim" name="«Yangi alifbo» tizimi">
        <bpmn:flowNodeRef>T_Convert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Susp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tekshiruvchi" name="Masʼul tekshiruvchi">
        <bpmn:flowNodeRef>T_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Dict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AddDict</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Hujjatni yangi alifboga oʻtkazish kerak">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_Open" name="Hujjatni Word&#x27;da ochish">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Click" name="«Hujjatni öğiriş» tugmasini bosish">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Convert" name="Yozuvni aniqlash va oʻgirish">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:property id="Prop_Convert" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_1"><bpmn:sourceRef>DS_Dict</bpmn:sourceRef><bpmn:targetRef>Prop_Convert</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Report" name="Hisobot shakllantirish">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Susp" name="Shubhali soʻzlar bormi?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Review" name="Shubhali soʻzlarni tekshirish">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Dict" name="Lugʻatga qoʻshish kerakmi?">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_AddDict" name="Soʻzni lugʻatga qoʻshish">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_1"><bpmn:targetRef>DS_Dict</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="T_Save" name="Hujjatni saqlash va yuborish">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End" name="Hujjat yangi alifboda">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_Open"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T_Open" targetRef="T_Click"/>
    <bpmn:sequenceFlow id="F3" sourceRef="T_Click" targetRef="T_Convert"/>
    <bpmn:sequenceFlow id="F4" sourceRef="T_Convert" targetRef="T_Report"/>
    <bpmn:sequenceFlow id="F5" sourceRef="T_Report" targetRef="G_Susp"/>
    <bpmn:sequenceFlow id="F6" name="Yoʻq" sourceRef="G_Susp" targetRef="T_Save"/>
    <bpmn:sequenceFlow id="F7" name="Ha" sourceRef="G_Susp" targetRef="T_Review"/>
    <bpmn:sequenceFlow id="F8" sourceRef="T_Review" targetRef="G_Dict"/>
    <bpmn:sequenceFlow id="F9" name="Yoʻq" sourceRef="G_Dict" targetRef="T_Save"/>
    <bpmn:sequenceFlow id="F10" name="Ha" sourceRef="G_Dict" targetRef="T_AddDict"/>
    <bpmn:sequenceFlow id="F11" name="Qayta oʻgirish" sourceRef="T_AddDict" targetRef="T_Convert"/>
    <bpmn:sequenceFlow id="F12" sourceRef="T_Save" targetRef="End"/>
    <bpmn:dataStoreReference id="DS_Dict" name="Lugʻatlar (istisno, himoyalangan soʻzlar)"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_1">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool_Tashkilot" isHorizontal="true"><dc:Bounds x="100" y="60" width="1420" height="540"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Xodim_di" bpmnElement="Lane_Xodim" isHorizontal="true"><dc:Bounds x="130" y="60" width="1390" height="180"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Tizim_di" bpmnElement="Lane_Tizim" isHorizontal="true"><dc:Bounds x="130" y="240" width="1390" height="180"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Tekshiruvchi_di" bpmnElement="Lane_Tekshiruvchi" isHorizontal="true"><dc:Bounds x="130" y="420" width="1390" height="180"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="180" y="132" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="148" y="173" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Open_di" bpmnElement="T_Open"><dc:Bounds x="260" y="110" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Click_di" bpmnElement="T_Click"><dc:Bounds x="420" y="110" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Convert_di" bpmnElement="T_Convert"><dc:Bounds x="580" y="290" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Report_di" bpmnElement="T_Report"><dc:Bounds x="740" y="290" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Susp_di" bpmnElement="G_Susp" isMarkerVisible="true"><dc:Bounds x="905" y="305" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="960" y="335" width="110" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Review_di" bpmnElement="T_Review"><dc:Bounds x="1000" y="470" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Dict_di" bpmnElement="G_Dict" isMarkerVisible="true"><dc:Bounds x="1165" y="485" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1070" y="430" width="110" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_AddDict_di" bpmnElement="T_AddDict"><dc:Bounds x="720" y="470" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Save_di" bpmnElement="T_Save"><dc:Bounds x="1240" y="110" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1412" y="132" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1380" y="173" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Dict_di" bpmnElement="DS_Dict"><dc:Bounds x="560" y="445" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="520" y="500" width="130" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="216" y="150"/><di:waypoint x="260" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="380" y="150"/><di:waypoint x="420" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="480" y="190"/><di:waypoint x="480" y="330"/><di:waypoint x="580" y="330"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="700" y="330"/><di:waypoint x="740" y="330"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="860" y="330"/><di:waypoint x="905" y="330"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="930" y="305"/><di:waypoint x="930" y="150"/><di:waypoint x="1240" y="150"/><bpmndi:BPMNLabel><dc:Bounds x="896" y="283" width="80" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="930" y="355"/><di:waypoint x="930" y="510"/><di:waypoint x="1000" y="510"/><bpmndi:BPMNLabel><dc:Bounds x="936" y="361" width="80" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1120" y="510"/><di:waypoint x="1165" y="510"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1215" y="510"/><di:waypoint x="1300" y="510"/><di:waypoint x="1300" y="190"/><bpmndi:BPMNLabel><dc:Bounds x="1221" y="516" width="80" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1190" y="535"/><di:waypoint x="1190" y="580"/><di:waypoint x="780" y="580"/><di:waypoint x="780" y="550"/><bpmndi:BPMNLabel><dc:Bounds x="1196" y="541" width="80" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="720" y="510"/><di:waypoint x="640" y="510"/><di:waypoint x="640" y="370"/><bpmndi:BPMNLabel><dc:Bounds x="646" y="430" width="80" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1360" y="150"/><di:waypoint x="1412" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DIA_1_di" bpmnElement="DIA_1"><di:waypoint x="585" y="445"/><di:waypoint x="610" y="370"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DOA_1_di" bpmnElement="DOA_1"><di:waypoint x="720" y="500"/><di:waypoint x="610" y="475"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
