{
  "manifest_version": 3,
  "name": "Yangi alifbo — özbek lotin 2026",
  "short_name": "Yangi alifbo",
  "version": "0.1.0",
  "description": "Eski lotin va kirill yozuvidagi matnni istalgan saytda 2026-yilgi yangi özbek alifbosiga öğiradi. Internetsiz işlaydi.",
  "homepage_url": "https://bilolceo.github.io/yangi-alifbo/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Yangi alifbo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "activeTab", "scripting", "storage"],
  "commands": {
    "convert-selection": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Belgilangan matnni yangi alifboga öğiriş"
    },
    "convert-page": {
      "description": "Sahifani yangi alifboda körsatiş"
    }
  }
}
